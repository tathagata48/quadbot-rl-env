# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---- Training output ----
# runs/main/ is the reference run and IS tracked on purpose (see README).
# Everything else under runs/ is local experiment output.
runs/*
!runs/main/
!runs/main/**

# ---- Rendered media & generated pages ----
# The README media under assets/ and the reference demo are tracked on purpose;
# everything else rendered locally is not.
*.mp4
*.gif
!assets/gif/*.gif
!runs/main/quadbot_demo.mp4
quadbot_sim.html

# ---- MuJoCo ----
MUJOCO_LOG.TXT

